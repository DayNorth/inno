# Plantilla de configuración. Copiar como .env y completar con valores reales.
# El archivo .env NUNCA debe versionarse (ver .gitignore en la raíz).

DB_SERVER=localhost
DB_PORT=1433
DB_DATABASE=VINKAPLANT_DB
DB_USER=<usuario_sql_dedicado>
DB_PASSWORD=<contrasena_sql>

PORT=3001

# Cadena aleatoria de alta entropía (mínimo 32 bytes).
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=<clave_secreta_jwt>

# Secreto DISTINTO para firmar el refresh token (nunca reutilizar JWT_SECRET/JWT_ACCESS_SECRET).
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_REFRESH_SECRET=<clave_secreta_refresh>

# Pepper del HMAC del refresh token. Secreto DISTINTO de JWT_SECRET/JWT_ACCESS_SECRET y de JWT_REFRESH_SECRET.
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
REFRESH_TOKEN_PEPPER=<pepper_refresh_token>

# Orígenes permitidos para CORS, separados por coma
CORS_ORIGIN=http://localhost:5173

# Solo "true" en desarrollo local con certificado autofirmado de SQL Server.
# En producción debe omitirse (o "false") y usar un certificado válido.
DB_TRUST_SERVER_CERTIFICATE=true

# Carpeta de archivos subidos (Documentos), relativa a Backend/ salvo ruta
# absoluta. NO debe quedar dentro de una carpeta servida como estática.
UPLOAD_DIR=uploads

# Tamaño máximo por archivo subido, en bytes (por defecto 10 MB).
UPLOAD_MAX_BYTES=10485760

# Rate limiting (ventana fija de 15 min). El general cubre TODOS los endpoints;
# los de /api/auth (10 login, 30 refresh/logout) son fijos y no se configuran.
RATE_LIMIT_GENERAL_MAX=300
RATE_LIMIT_SUBIDA_MAX=20
