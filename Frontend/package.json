{
  "name": "vinkaplant-frontend",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typegen": "react-router typegen",
    "dev": "react-router typegen && react-router dev",
    "build": "react-router typegen && react-router build && node scripts/comprobarSpa.mjs",
    "comprobar:spa": "node scripts/comprobarSpa.mjs",
    "preview": "vite preview",
    "typecheck": "react-router typegen && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "auditoria": "npm audit --audit-level=high",
    "verify": "npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.84.0",
    "react-router": "8.3.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@react-router/dev": "8.3.0",
    "@react-router/fs-routes": "8.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/jest-axe": "3.5.9",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.8.0",
    "jest-axe": "11.0.0",
    "jsdom": "30.0.1",
    "msw": "2.15.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  }
}
