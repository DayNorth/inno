# Variables para docker-compose (contenedor SQL Server de desarrollo).
# Copiar como .env en la raiz y completar. Este .env NUNCA debe versionarse
# (ver .gitignore).

# Contrasena del usuario sa. Debe cumplir la politica de complejidad de SQL
# Server (mayuscula, minuscula, numero y simbolo, minimo 8 caracteres) y debe
# coincidir con DB_PASSWORD en Backend/.env.
DB_SA_PASSWORD=<contrasena_sa_sql>

# Puerto en el host mapeado al 1433 del contenedor. 1434 evita choque si ya
# hay un SQL Server local escuchando en el 1433 por defecto.
DB_HOST_PORT=1434
